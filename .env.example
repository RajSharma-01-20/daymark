# Local development only. Replace placeholder secrets in your private .env.
DATABASE_URL=postgresql+psycopg://minisso:local_only_change_me@localhost:5432/minisso
DAYMARK_DATABASE_URL=postgresql+psycopg://minisso:local_only_change_me@localhost:5432/minisso
IDP_SECRET_KEY=replace-with-a-long-random-value
OIDC_SIGNING_KEY_PATH=keys/idp-rs256-private.pem
DAYMARK_CLIENT_ID=daymark-local
DAYMARK_CLIENT_SECRET=replace-with-a-different-long-random-value
IDP_ISSUER=http://localhost:5002
DAYMARK_URL=http://localhost:8101
DAYMARK_CALLBACK=http://localhost:8101/auth/callback
DAYMARK_POST_LOGOUT_REDIRECT=http://localhost:5174/
WEB_URL=http://localhost:5174
DAYMARK_SESSION_SECRET=replace-with-another-long-random-value
COOKIE_SECURE=false
